

`timescale 1ns / 1ps

interface UART_if( input logic clk);

    logic rst_n , st ;
    logic [7:0] din ;
    logic tx , tx_done ;
    
    modport UART_tb (
    
    input clk,
    output rst_n , st ,
    output din ,
    input tx , tx_done 
    
    );
    
    modport UART_main (
    
    input clk,
    input rst_n , st ,
    input din ,
    output tx , tx_done 
    
    );

endinterface 


class transaction;

    rand bit [7:0] din;
    //rand bit st , rst_n ;
   
endclass



class generator;

    mailbox #(transaction) gen2drv ;
    mailbox #(transaction) gen2scr ;
    
    function new( mailbox #(transaction) m1 , mailbox #(transaction) m2);
    
        gen2drv = m1;
        gen2scr = m2;
    
    endfunction
    
    task run();
    
        transaction tr;
        
        repeat(10) begin
        
            tr = new();
            
            assert( tr.randomize())
            else $error("error");
            
            gen2drv.put(tr);
            gen2scr.put(tr);
        
        end
    
    endtask
    
endclass




class driver;

    virtual UART_if.UART_tb vif;
    mailbox #(transaction) gen2drv;
    transaction tr ;
    
    function new ( mailbox #(transaction) mbx , virtual UART_if.UART_tb v );
    
        vif = v;
        gen2drv = mbx;
        
    endfunction

    task run();
        
        vif.st = 0;
        vif.din = 8'h00;
        
        vif.rst_n = 1'b0;
            
        repeat(2) begin
            @(negedge vif.clk);
        end
        
        vif.rst_n = 1'b1;
        
        repeat (10) begin
            
            gen2drv.get(tr);
            
            @ (negedge vif.clk);
            vif.din = tr.din;
            vif.st = 1;
            //repeat(2)
            @ (negedge vif.clk);
            vif.st = 0;
            
            wait (vif.tx_done == 1'b1);
            wait (vif.tx_done == 1'b0);
            
        end
    
    endtask
    
endclass


class monitor;

    virtual UART_if.UART_tb vif;
    mailbox #(transaction) mon2scr;
    transaction tr;
    bit [7:0] data;
    
    function new( virtual UART_if.UART_tb v , mailbox #(transaction) m  );
    
        vif = v;
        mon2scr = m;
    
    endfunction
    
    task run();
    
        repeat(10) begin
        
            @ (negedge vif.tx);
            
            @(posedge vif.clk);
        
            for (int i=0 ; i<8 ; i++) begin
        
                @ (negedge vif.clk)
                data [i] = vif.tx;
            
            end
            
            tr = new();
            tr.din = data;
            mon2scr.put(tr);
            
        end
        
    endtask
    
endclass


class scoreboard;
    
    transaction tr1 , tr2;
    mailbox #(transaction) mon2scr ;
    mailbox #(transaction) gen2scr ;
    
    function new( mailbox #(transaction) m1 , mailbox #(transaction) m2 );
    
        mon2scr = m1;
        gen2scr = m2;
    
    endfunction
    
    task run();
    
        forever begin
        
            mon2scr.get(tr1);
            gen2scr.get(tr2);
        
            //assert ( tr1.din == tr2.din)
            //else $error("error");
            
            if (tr1.din === tr2.din)
                $display("PASS: Expected=%02h Observed=%02h",tr2.din, tr1.din);
            
            else
                $error("FAIL: Expected=%02h Observed=%02h",tr2.din, tr1.din);
                
        end
    
    endtask

endclass




module UART_tb();

    logic clk;
    mailbox #(transaction) gen2drv ;
    mailbox #(transaction) mon2scr ;
    mailbox #(transaction) gen2scr ;
    generator gen;
    driver drv;
    monitor mon;
    scoreboard scr;
    
   // UART_main dut (.clk(uif.clk)  );
   
    initial begin
        clk = 1'b0;
    end
    
    always #5 clk = ~clk;
    
    UART_if uif(clk);
    
     UART_main dut (
        .clk     (clk),
        .rst_n   (uif.rst_n),
        .st      (uif.st),
        .din     (uif.din),
        .tx      (uif.tx),
        .tx_done (uif.tx_done)
    );
    
    initial begin
    
        gen2drv = new();
        gen2scr = new();
        mon2scr = new();
        gen = new( gen2drv , gen2scr );
        drv = new( gen2drv , uif);
        mon = new( uif , mon2scr );
        scr = new( mon2scr , gen2scr );
        
        fork
            gen.run();
            drv.run();
            mon.run();
            scr.run();
        join
        
        $finish();
        
    end
    
endmodule
